<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sdc_ackermann">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></visual>
      </link>
    </model>
    <model name="ackermann_car">
      <pose>0 0 0.65 0 0 0</pose>
      <link name="chassis">
        <inertial><mass>80</mass><inertia><ixx>20</ixx><iyy>30</iyy><izz>40</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>2.5 1 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.5 1 0.3</size></box></geometry></visual>
      </link>
      <link name="front_left">
        <pose>1 0.5 -0.3 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></visual>
      </link>
      <link name="front_right">
        <pose>1 -0.5 -0.3 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></visual>
      </link>
      <link name="rear_left">
        <pose>-1 0.5 -0.3 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></visual>
      </link>
      <link name="rear_right">
        <pose>-1 -0.5 -0.3 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.15</length></cylinder></geometry></visual>
      </link>
      <joint name="front_left_steering" type="revolute"><parent>chassis</parent><child>front_left</child><axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper></limit></axis></joint>
      <joint name="front_right_steering" type="revolute"><parent>chassis</parent><child>front_right</child><axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper></limit></axis></joint>
      <joint name="rear_left_drive" type="revolute"><parent>chassis</parent><child>rear_left</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rear_right_drive" type="revolute"><parent>chassis</parent><child>rear_right</child><axis><xyz>0 1 0</xyz></axis></joint>
      <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
        <left_joint>rear_left_drive</left_joint><right_joint>rear_right_drive</right_joint>
        <left_steering_joint>front_left_steering</left_steering_joint>
        <right_steering_joint>front_right_steering</right_steering_joint>
        <wheel_separation>1.0</wheel_separation><wheel_base>2.0</wheel_base><wheel_radius>0.3</wheel_radius>
        <topic>/model/ackermann_car/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>
