Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
  - Class: sdc/HudPanel
    Name: SDC HUD
    Enabled: true

Visualization Manager:
  Class: ""
  Displays:
    # ---- 全局选项 ----
    - Class: rviz_common/Grid
      Name: Grid
      Reference Frame: world
      Plane Cell Count: 60
      Cell Size: 1

    # ---- 环形道路 Marker（Transient Local：打开即可看到） ----
    - Class: rviz_default_plugins/MarkerArray
      Name: Road Markers
      Enabled: true
      Topic:
        Value: /simulation/markers
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last

    # ---- 动态可视化（小车/路径/轨迹/状态文本） ----
    - Class: rviz_default_plugins/MarkerArray
      Name: Live Markers
      Enabled: true
      Topic:
        Value: /simulation/markers_live
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last

    # ---- LIDAR 点云 ----
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Value: /sensor/lidar
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 200; 60
      Use Fixed Frame: true
      Use rainbow: false

    # ---- TF 显示小车坐标系 ----
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true

  Enabled: true
  Global Options:
    Background Color: 30;30;35
    Fixed Frame: world
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 65
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Top-down Orbit View
      Pitch: 1.2
      Yaw: 3.8
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 65
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Name: Top-down Orbit View
        Pitch: 1.2
        Yaw: 3.8
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Top-down Ortho
        Scale: 1.6

Window Geometry:
  Height: 800
  Width: 1200
