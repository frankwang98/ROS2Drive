Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time

Visualization Manager:
  Class: ""
  Displays:
    # ---- 全局选项 ----
    - Class: rviz_common/Grid
      Name: Grid
      Reference Frame: world
      Plane Cell Count: 60
      Cell Size: 1

    # ---- 环形道路 Marker ----
    - Class: rviz_default_plugins/MarkerArray
      Name: Simulation Markers
      Topic:
        Value: /simulation/markers
        Reliability: Reliable

    # ---- TF 显示小车坐标系 ----
    - Class: rviz_default_plugins/TF
      Name: TF

  Enabled: true
  Global Options:
    Background Color: 30;30;35
    Fixed Frame: world
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 65
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Top-down Orbit View
      Pitch: 1.2
      Yaw: 3.8
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 65
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Name: Top-down Orbit View
        Pitch: 1.2
        Yaw: 3.8
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Top-down Ortho
        Scale: 1.6

Window Geometry:
  Height: 800
  Width: 1200
